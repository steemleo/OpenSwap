{
  "name": "openswap",
  "version": "0.1.0",
  "description": "OpenSwap CLI by LeoDex — open-source crosschain swaps, right from your terminal. 30+ chains, for humans, AI agents, and bots. Powered by LeoKit.",
  "type": "module",
  "license": "MIT",
  "author": "LeoFinance <contact@leofinance.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steemleo/OpenSwap.git"
  },
  "bugs": {
    "url": "https://github.com/steemleo/OpenSwap/issues"
  },
  "homepage": "https://github.com/steemleo/OpenSwap#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "openswap": "dist/index.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "AGENT-CONTRACT.md",
    "llms.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node scripts/gen-brand.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "brand:social": "node scripts/gen-social-png.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@noble/hashes": "^2.2.0",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "viem": "^2.55.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "open-source",
    "openswap",
    "crosschain",
    "swap",
    "cli",
    "bitcoin",
    "ethereum",
    "defi",
    "chainflip",
    "thorchain",
    "leokit",
    "leodex",
    "agent",
    "mcp"
  ]
}
